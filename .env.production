# CRA "npm run build" paytida .env o'rniga SHUNI o'qiydi.
# Backend alohida subdomenda turadi (server konventsiyasi: api.medi-care.uz kabi).
#   ${serverApi}/product/all  -> https://api.pettynara.uz/product/all
#   ${serverApi}/${image}     -> https://api.pettynara.uz/uploads/...
#
# Cookie eslatmasi: pettynara.uz va api.pettynara.uz brauzer uchun BIR XIL
# "site" (eTLD+1 = pettynara.uz), shuning uchun SameSite=Lax sessiya cookie'si
# ishlayveradi — backend kodiga tegish shart emas.
REACT_APP_API_URL=https://api.pettynara.uz

# Toss Payments test client key (public docs key, test mode only)
REACT_APP_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
